# Copia a .env.local y completa los valores.
# Las credenciales son para los scripts de sincronización, nunca para el navegador.

SHOPIFY_SHOP=mondano-chile
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-10

# Secreto de webhooks (solo si se añaden webhooks firmados)
SHOPIFY_SECRET=
