{
  "rewrites": [
    { "source": "/", "destination": "/visor-tallas.html" }
  ],
  "headers": [
    {
      "source": "/visor-data.json",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=600" }]
    },
    {
      "source": "/visor-tallas.html",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=600, stale-while-revalidate=3600" }]
    },
    {
      "source": "/fits/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
