{%- comment -%}
  Sección: Encuentra tu talla

  Coloca el visor de tallas **justo debajo del selector de tallas** de la ficha.
  El visor vive en otro dominio (Vercel); aquí lo cargamos en línea (iframe) o
  en un diálogo, y le devolvemos la talla elegida a Shopify.

  Ajustes:
    · Colocación   → automática (debajo del selector) o donde esté la sección
    · Presentación → en línea (se despliega), en línea siempre visible o ventana modal

  La reubicación es con JS: el bloque se mueve al nodo siguiente al selector de
  tallas, así que funciona con cualquier tema (Dawn, Wokiee, etc.) sin tocar el
  código del tema.
{%- endcomment -%}

{%- liquid
  assign viewer = section.settings.launch_url | default: 'https://mondanosize.vercel.app'
  assign name_enc = product.title | url_encode
  assign viewer_url = viewer | append: '?sku=' | append: product.handle | append: '&name=' | append: name_enc
  assign viewer_inline_url = viewer_url | append: '&mode=inline'

  assign hide = false
  assign hide_list = section.settings.hide_handles | split: ','
  for h in hide_list
    assign hh = h | strip
    if hh == product.handle
      assign hide = true
    endif
  endfor

  assign size_index = 0
  assign size_option = ''
  for option in product.options_with_values
    if option.name == 'Talla' or option.name == 'Tamaño'
      assign size_index = forloop.index0
      assign size_option = option.name
    endif
  endfor

  if size_option == blank
    assign hide = true
  endif

  assign display = section.settings.visor_display | default: 'inline'
  assign placement = section.settings.visor_placement | default: 'auto'
  assign visor_height = section.settings.visor_height | default: 620

  assign variants_json = ''
  assign seen = ',,'
  for v in product.variants
    case size_index
      when 0
        assign size_label = v.option1
      when 1
        assign size_label = v.option2
      else
        assign size_label = v.option3
    endcase
    assign key = ',' | append: size_label | append: ','
    unless seen contains key
      assign seen = seen | append: size_label | append: ','
      assign label_json = size_label | json
      assign variants_json = variants_json | append: label_json | append: ':' | append: v.id | append: ','
    endunless
  endfor
  assign variants_json = variants_json | remove_last: ','
-%}

{%- unless hide -%}
<div
  class="visor-root"
  id="visor-{{ section.id }}"
  data-mode="{{ display }}"
  data-placement="{{ placement }}"
  data-expanded="false"
>

  <button type="button" class="visor-btn" data-visor-open aria-expanded="false" aria-controls="visor-panel-{{ section.id }}">
    <span class="visor-btn__icon" aria-hidden="true">↔</span>
    <span>{{ section.settings.label }}</span>
    <span class="visor-btn__arrow" aria-hidden="true">→</span>
  </button>

  {%- if section.settings.hint != blank -%}
    <p class="visor-hint">{{ section.settings.hint }}</p>
  {%- endif -%}

  <p class="visor-status" data-visor-status hidden aria-live="polite"></p>

  {%- comment -%} Visor en línea: se despliega justo debajo del selector de tallas {%- endcomment -%}
  {%- if display != 'modal' -%}
    <div class="visor-panel" id="visor-panel-{{ section.id }}" data-visor-panel hidden>
      <div class="visor-panel__head">
        <span class="visor-panel__title">{{ section.settings.label }}</span>
        <button type="button" class="visor-panel__close" data-visor-close aria-label="Cerrar el visor">✕</button>
      </div>
      <iframe
        class="visor-panel__frame"
        data-visor-frame
        title="{{ section.settings.label | escape }}"
        loading="lazy"
        allow="clipboard-write"
        style="--visor-height: {{ visor_height }}px"
      ></iframe>
    </div>
  {%- endif -%}

  {%- comment -%} Visor en ventana modal {%- endcomment -%}
  {%- if display == 'modal' -%}
    <dialog class="visor-dialog" data-visor-dialog aria-label="{{ section.settings.label | escape }}">
      <div class="visor-dialog__head">
        <span class="visor-dialog__title">{{ product.title | escape }}</span>
        <button type="button" class="visor-dialog__close" data-visor-close aria-label="Cerrar">✕</button>
      </div>
      <iframe
        class="visor-dialog__frame"
        data-visor-frame
        title="{{ section.settings.label | escape }}"
        loading="lazy"
        allow="clipboard-write"
      ></iframe>
    </dialog>
  {%- endif -%}

  {%- comment -%} Mapa talla → variant id {%- endcomment -%}
  <script type="application/json" data-visor-variants>
    { {{ variants_json }} }
  </script>

  <script>
    (function () {
      var root = document.getElementById('visor-{{ section.id }}');
      if (!root) return;

      var mode = root.getAttribute('data-mode') || 'inline';
      var dlg = root.querySelector('[data-visor-dialog]');
      var panel = root.querySelector('[data-visor-panel]');
      var frame = root.querySelector('[data-visor-frame]');
      var btn = root.querySelector('[data-visor-open]');
      var status = root.querySelector('[data-visor-status]');
      var url = {{ viewer_url | json }};
      var inlineUrl = {{ viewer_inline_url | json }};
      var optName = {{ size_option | json }};
      var variants = {};
      try { variants = JSON.parse(root.querySelector('[data-visor-variants]').textContent); } catch (e) {}
      var frameHeight = 0;

      // El wrapper de la sección original (para ocultarlo al mover el bloque)
      var originWrap = root.closest('.shopify-section');

      function track(event) {
        (window.dataLayer = window.dataLayer || []).push({
          event: event,
          product: {{ product.handle | json }}
        });
      }

      /* ---------- colocación: justo debajo del selector de tallas ---------- */

      function productScope() {
        var sections = document.querySelectorAll('.shopify-section');
        var fallback = null;

        for (var i = 0; i < sections.length; i++) {
          var sec = sections[i];
          if (!sec.querySelector('form[action*="/cart/add"]')) continue;
          // solo la ficha visible (descarta modales y quick-view ocultos)
          if (sec.offsetParent === null) continue;
          if (sec.querySelector('[id*="ProductInfo"]')) return sec;
          if (!fallback && sec.querySelector('variant-selects')) fallback = sec;
        }
        return fallback || document;
      }

      function sizeAnchor() {
        var s = productScope();

        // Tema con <variant-selects> (Wookiee, Dawn 2.0…)
        var vs = s.querySelector('variant-selects');
        if (vs) return vs;

        // Tema con radios de la opción de talla
        if (optName) {
          var radios = s.querySelectorAll('input[type="radio"][name="' + optName + '"]');
          if (radios.length) {
            return radios[0].closest('fieldset') ||
                   radios[0].closest('.product-options') ||
                   radios[0].parentElement;
          }
        }

        // Tema con <select name="id">
        var sel = s.querySelector('select[name="id"]');
        if (sel) return sel.closest('fieldset') || sel.parentElement || sel;

        return null;
      }

      function relocate() {
        if (root.getAttribute('data-placement') !== 'auto') return false;

        var anchor = sizeAnchor();
        if (!anchor || !anchor.parentNode) return false;
        if (anchor.nextElementSibling === root) return true;

        anchor.parentNode.insertBefore(root, anchor.nextSibling);

        // La sección quedó vacía: la ocultamos para no dejar un hueco
        if (originWrap && !originWrap.querySelector(':scope > *:not(.visor-root)')) {
          originWrap.style.display = 'none';
        }
        return true;
      }

      function boot() {
        relocate();
        document.addEventListener('shopify:section:load', relocate);
        document.addEventListener('shopify:section:select', relocate);

        // Si el tema redibuja el selector de tallas, volvemos a colocarnos
        if (window.MutationObserver) {
          var pending = null;
          var mo = new MutationObserver(function () {
            if (pending) return;
            pending = setTimeout(function () { pending = null; relocate(); }, 250);
          });
          mo.observe(document.body, { childList: true, subtree: true });
        }

        if (mode === 'inline_open') {
          loadFrame();
          setExpanded(true);
        }
      }

      /* ---------- apertura / cierre ---------- */

      function loadFrame() {
        if (!frame || frame.getAttribute('src')) return;
        frame.setAttribute('src', mode === 'modal' ? url : inlineUrl);
      }

      function setExpanded(on) {
        if (!panel) return;
        panel.hidden = !on;
        root.setAttribute('data-expanded', on ? 'true' : 'false');
        if (btn) btn.setAttribute('aria-expanded', on ? 'true' : 'false');
      }

      function open() {
        loadFrame();
        if (mode === 'modal') {
          if (dlg) { if (dlg.showModal) { dlg.showModal(); } else { dlg.setAttribute('open', ''); } }
          document.documentElement.style.overflow = 'hidden';
        } else {
          setExpanded(true);
          if (panel && panel.scrollIntoView) {
            panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          }
        }
        track('size_guide_open');
      }

      function close() {
        if (mode === 'modal') {
          if (dlg) { if (dlg.close) { dlg.close(); } else { dlg.removeAttribute('open'); } }
          document.documentElement.style.overflow = '';
        } else {
          setExpanded(false);
        }
      }

      /* ---------- sincronización con la variante ---------- */

      function selectVariant(size) {
        var id = variants[size];
        if (!id) return;

        var applied = false;

        // 1) radios del selector de tallas (Wokiee y similares)
        if (optName) {
          var radios = document.querySelectorAll('input[type="radio"][name="' + optName + '"]');
          for (var i = 0; i < radios.length; i++) {
            if (radios[i].value === size) {
              radios[i].click();
              applied = true;
              break;
            }
          }
        }

        // 2) <select name="id"> (temas con lista desplegable)
        if (!applied) {
          var select = document.querySelector('form[action*="/cart/add"] select[name="id"]') ||
                       document.querySelector('select[name="id"]');
          if (select) {
            select.value = String(id);
            select.dispatchEvent(new Event('change', { bubbles: true }));
            applied = true;
          }
        }

        // 3) input[name="id"][value="<variant id>"]
        if (!applied) {
          var radio = document.querySelector('input[name="id"][value="' + id + '"]');
          if (radio) { radio.click(); applied = true; }
        }

        // 4) último recurso: el input oculto del formulario
        if (!applied) {
          var hidden = document.querySelector('form[action*="/cart/add"] input[name="id"]');
          if (hidden) hidden.value = String(id);
        }

        // La URL la actualiza el tema al cambiar la variante; refrescamos el valor real
        setTimeout(function () {
          var current = id;
          var hidden = document.querySelector('form[action*="/cart/add"] input[name="id"]');
          if (hidden && hidden.value) current = hidden.value;
          try {
            var u = new URL(location.href);
            u.searchParams.set('variant', current);
            history.replaceState({}, '', u);
          } catch (e) {}

          if (status) {
            status.textContent = 'Talla ' + size + ' aplicada a la variante.';
            status.hidden = false;
          }
          track('size_selected');
        }, 0);
      }

      /* ---------- eventos ---------- */

      if (btn) {
        btn.addEventListener('click', function () {
          if (mode === 'modal') { open(); return; }
          var willOpen = !panel || panel.hidden;
          if (willOpen) {
            loadFrame();
            setExpanded(true);
            track('size_guide_open');
          } else {
            setExpanded(false);
          }
        });
      }

      root.querySelectorAll('[data-visor-close]').forEach(function (b) {
        b.addEventListener('click', close);
      });

      if (dlg) {
        dlg.addEventListener('click', function (e) { if (e.target === dlg) close(); });
        dlg.addEventListener('cancel', function () { document.documentElement.style.overflow = ''; });
      }

      window.addEventListener('message', function (e) {
        if (!e.data) return;
        if (e.data.type === 'mondano:close') close();
        if (e.data.type === 'mondano:size') selectVariant(e.data.size);
        if (e.data.type === 'mondano:height' && mode !== 'modal' && frame) {
          var h = Math.max(340, Math.min(Number(e.data.height) || 0, 860));
          if (h !== frameHeight) {
            frameHeight = h;
            frame.style.height = h + 'px';
          }
        }
      });

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', boot);
      } else {
        boot();
      }
    })();
  </script>

  <style>
    .visor-btn {
      display: flex; align-items: center; gap: 10px; width: 100%;
      padding: 14px 16px; border: 1px solid currentColor; border-radius: 10px;
      background: transparent; color: inherit; font: inherit; font-size: 14px; font-weight: 600;
      cursor: pointer; text-align: left; transition: background .15s, color .15s;
    }
    .visor-btn:hover { background: rgba(0, 0, 0, .04); }
    .visor-btn:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; }
    .visor-btn__icon { font-size: 16px; opacity: .7; }
    .visor-btn__arrow { margin-left: auto; opacity: .6; }
    .visor-hint { margin: 8px 0 0; font-size: 11.5px; opacity: .65; text-align: center; }
    .visor-status { margin: 8px 0 0; font-size: 12px; text-align: center; opacity: .8; }

    /* visor en línea */
    .visor-panel {
      margin-top: 12px; border: 1px solid #ebe2d9; border-radius: 14px;
      overflow: hidden; background: #faf6f2;
    }
    .visor-panel[hidden] { display: none; }
    .visor-panel__head {
      display: flex; align-items: center; justify-content: space-between; gap: 12px;
      padding: 10px 12px; border-bottom: 1px solid #ebe2d9; background: #fff;
    }
    .visor-panel__title {
      font-size: 11.5px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase;
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .visor-panel__close {
      flex: 0 0 auto; width: 30px; height: 30px; border: 1px solid #ebe2d9; border-radius: 8px;
      background: #fff; font-size: 14px; line-height: 1; cursor: pointer;
    }
    .visor-panel__frame {
      display: block; width: 100%; height: var(--visor-height, 620px);
      border: 0; background: #faf6f2;
    }
    .visor-root[data-mode="inline_open"][data-expanded="true"] .visor-btn { display: none; }

    /* visor en ventana modal */
    .visor-dialog {
      padding: 0; border: 0; border-radius: 16px; width: min(960px, 100vw);
      max-width: 100vw; max-height: 100dvh; background: #faf6f2; overflow: hidden;
    }
    .visor-dialog::backdrop { background: rgba(20, 18, 24, .55); }
    .visor-dialog__head {
      display: flex; align-items: center; justify-content: space-between; gap: 12px;
      padding: 12px 14px; border-bottom: 1px solid #ebe2d9; background: #fff;
    }
    .visor-dialog__title {
      font-size: 12px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase;
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .visor-dialog__close {
      flex: 0 0 auto; width: 34px; height: 34px; border: 1px solid #ebe2d9; border-radius: 9px;
      background: #fff; font-size: 15px; line-height: 1; cursor: pointer;
    }
    .visor-dialog__frame { display: block; width: 100%; height: min(88dvh, 860px); border: 0; }

    @media (max-width: 820px) {
      .visor-panel__frame { height: min(var(--visor-height, 620px), 74dvh); }
      .visor-dialog {
        width: 100vw; height: 100dvh; max-height: 100dvh; border-radius: 0; margin: 0;
      }
      .visor-dialog__frame { height: calc(100dvh - 59px); }
    }
  </style>
</div>

{%- endunless -%}

{% schema %}
{
  "name": "Visor de talla",
  "settings": [
    {
      "type": "text",
      "id": "launch_url",
      "label": "URL del visor",
      "default": "https://mondanosize.vercel.app",
      "info": "Dominio en Vercel donde está desplegado el visor."
    },
    {
      "type": "select",
      "id": "visor_placement",
      "label": "Colocación",
      "default": "auto",
      "options": [
        { "value": "auto", "label": "Debajo del selector de tallas" },
        { "value": "section", "label": "En el lugar de la sección" }
      ],
      "info": "Automático mueve el bloque al selector de tallas con JS, sin tocar el tema."
    },
    {
      "type": "select",
      "id": "visor_display",
      "label": "Presentación",
      "default": "inline",
      "options": [
        { "value": "inline", "label": "En línea (se despliega bajo el selector)" },
        { "value": "inline_open", "label": "En línea siempre visible" },
        { "value": "modal", "label": "Ventana modal" }
      ]
    },
    {
      "type": "select",
      "id": "visor_height",
      "label": "Alto del visor en línea",
      "default": "620",
      "options": [
        { "value": "520", "label": "Compacto (520 px)" },
        { "value": "620", "label": "Medio (620 px)" },
        { "value": "720", "label": "Grande (720 px)" }
      ]
    },
    {
      "type": "text",
      "id": "label",
      "label": "Texto del botón",
      "default": "Encuentra tu talla"
    },
    {
      "type": "text",
      "id": "hint",
      "label": "Texto de ayuda",
      "default": "Sin salir de la ficha · no se guardan tus datos"
    },
    {
      "type": "textarea",
      "id": "hide_handles",
      "label": "Ocultar en estos productos (handles)",
      "info": "Lista separada por comas. Úsala para fichas que aún no tienen tabla de tallas.",
      "default": "falda-camel-leather,abrigo-camel-leather,vestido-samba-rose,vestido-brisa-carioca,conjunto-ipanema,conjunto-copacabana,vestido-eolo,pantalon-flow-maestro,cortaviento-susurro-del-bosque,vestido-brisa-de-verano,conjunto-dos-piezas-susurro-de-atardecer,vestido-olas-nomadas,conjunto-dos-piezas-susurro-de-olas,denim-jacket,straight-jeans,polera-you-are-lucky,snake-baggy-jeans,black-baggy-jeans,vestido-tirantes-full-colors,parka-acorchada-sin-mangas,poleron-1,parka-impermeable-urban"
    }
  ],
  "presets": [
    { "name": "Visor de talla" }
  ]
}
{% endschema %}
